{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "RateLimiting": {
    "GuestSession": { "PermitLimit": 10, "WindowMinutes": 60 },
    "Register": { "PermitLimit": 5, "WindowMinutes": 60 },
    "Login": { "PermitLimit": 20, "WindowMinutes": 15 },
    "KnownProxies": []
  },
  "AllowedHosts": "*"
}
