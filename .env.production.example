# Copy to .env.production on the server (mode 600). Never commit real values.
GOMOKU_DOMAIN=game.example.com
GOMOKU_API_IMAGE=registry.example.com/private/gomoku-api@sha256:REPLACE_WITH_64_HEX_DIGEST
GOMOKU_POSTGRES_PASSWORD_FILE=/srv/gomoku/secrets/postgres_password
GOMOKU_DP_CERT_FILE=/srv/gomoku/secrets/data_protection.pfx
GOMOKU_DP_CERT_PASSWORD_FILE=/srv/gomoku/secrets/data_protection_password
GOMOKU_REDIS_NAMESPACE=gomoku:production
# Change these together if the subnet conflicts with another Docker network.
GOMOKU_FRONT_SUBNET=172.29.217.0/24
GOMOKU_PROXY_IP=172.29.217.10
